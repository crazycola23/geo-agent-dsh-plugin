{
  "name": "@geo-internal/geo-agent-dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Run the GEO content workflow from DSH: project material, question sets, articles, publishing, detection and reports — with a per-project API token and an approval step before every write.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crazycola23/geo-agent-dsh-plugin.git"
  },
  "homepage": "https://github.com/crazycola23/geo-agent-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/crazycola23/geo-agent-dsh-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "geo",
    "content-workflow"
  ],
  "type": "module",
  "main": "./src/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "src/index.js",
    "src/config.js",
    "src/auth-provider.js",
    "src/project-context.js",
    "src/api-client.js",
    "src/schema.js",
    "src/generated/openapi.catalog.json",
    "src/client",
    "lib/client.js",
    "tsdown.client.config.ts",
    "scripts/install-skill.mjs",
    "sources"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build:client": "tsdown -c ./tsdown.client.config.ts",
    "generate:catalog": "node ./scripts/generate-catalog.mjs",
    "prepack": "npm run build:client",
    "install:skill": "node ./scripts/install-skill.mjs",
    "test": "node --test",
    "validate": "node ./scripts/validate-catalog.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "js-yaml": "4.1.0",
    "lightningcss": "1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.15.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
